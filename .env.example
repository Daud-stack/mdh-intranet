# Environment Configuration for MDH Intranet
# Copy this file to .env and update with your production values
# NEVER commit the .env file to version control!

# Django Security Settings
DJANGO_SECRET_KEY=your-secret-key-here-generate-new-one-for-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Database (if using PostgreSQL in production)
# DATABASE_URL=postgresql://user:password@localhost:5432/mdh_intranet

# Email Configuration (for password resets, notifications)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@example.com
# EMAIL_HOST_PASSWORD=your-app-password

# Redis Cache (optional, for production performance)
# REDIS_URL=redis://127.0.0.1:6379/1

# Generate a new SECRET_KEY with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
